# label_service 容器的环境变量（复制成 .env 后按需改；不建也能跑，全走 config.py 默认值）

# 宿主机上的 NAS / 素材库路径 → 容器里挂到同名路径，接口传相对路径两边才对得上
NAS_ROOT_HOST=/home/toky/ai_data
NAS_ROOT=/home/toky/ai_data
MATERIAL_ROOT_HOST=/home/toky/alg_material
MATERIAL_ROOT=/home/toky/alg_material

LABEL_SERVICE_PORT=8383
TZ=Asia/Shanghai

# 换模型改这个（相对仓库根目录的通配符，必须只匹配到一个文件）
# LABEL_MODEL=results/processed_2026_8_11-2026_8_27_raw_missing_drop_window/16hz_remap_custom_3class/rf/*.pkl

# 推理并发：默认 CPU 核数-2；留几个槽位给工作台点「AI预标注」的交互式请求
# LABEL_INFER_WORKERS=22
# LABEL_INFER_RESERVE=2
